# Copy to .env and fill in. Don't commit .env.

# Public HTTPS URL of this IdP — must match the Caddyfile site address.
IDP_URL=https://idp.example.com

# Public HTTPS URL of your Karakeep instance — must match Karakeep's
# NEXTAUTH_URL exactly (scheme + host, no trailing slash).
KARAKEEP_URL=https://karakeep.example.com

# Random shared secret between the IdP and Karakeep (same value goes in
# Karakeep's OAuth client secret setting). Generate with:
#   openssl rand -base64 32
KARAKEEP_CLIENT_SECRET=

# Only if the admin private key in secrets/admin-private-key.asc has a
# passphrase. Leave empty otherwise.
ADMIN_PGP_PASSPHRASE=
